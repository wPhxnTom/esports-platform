{
  "name": "esports-platform-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "start:prod": "prisma db push && node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:push:sqlite": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:generate:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:seed": "tsx src/seed.ts",
    "db:seed:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma && tsx src/seed.ts",
    "db:studio": "prisma studio",
    "db:studio:sqlite": "prisma studio --schema=prisma/schema.sqlite.prisma",
    "switch:sqlite": "node -e \"require('fs').copyFileSync('prisma/schema.sqlite.prisma','prisma/schema.prisma')\"",
    "switch:postgres": "node -e \"require('fs').copyFileSync('prisma/schema.postgres.prisma','prisma/schema.prisma')\""
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "stripe": "^22.2.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.3",
    "jest": "^30.4.2",
    "prisma": "^6.6.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
