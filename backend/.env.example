# Railway fournit automatiquement DATABASE_URL (PostgreSQL)
# Pour le dev local avec PostgreSQL (Docker) :
# DATABASE_URL="postgresql://esports:esports123@localhost:5432/esports_platform"
DATABASE_URL="postgresql://esports:esports123@localhost:5432/esports_platform"

JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000

# Stripe (optionnel)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# URL de l'app (frontend) pour les redirections Stripe
APP_URL="http://localhost:3001"
