# Railway fournit automatiquement DATABASE_URL (PostgreSQL)
# Pour le dev local avec PostgreSQL (Docker) : docker compose up -d
# DATABASE_URL="postgresql://esports:esports123@localhost:5432/esports_platform"

# Avec SQLite (local, sans Docker) : utiliser prisma/schema.sqlite.prisma
# DATABASE_URL="file:./dev.db"

JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000

# Stripe (optionnel - laisser vide si pas utilisé)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# URL du frontend (Vercel) pour les redirections Stripe et CORS
FRONTEND_URL="http://localhost:3001"
